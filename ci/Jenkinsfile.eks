// Promote the already tested, public release; infrastructure requires separate approval.
pipeline {
    agent any
    options { skipDefaultCheckout(true); disableConcurrentBuilds(); timeout(time: 15, unit: 'MINUTES') }
    environment {
        RELEASE_IMAGE = 'ayyoub1/events-tache@sha256:abd5ce51159c9588d7f863c5a9682c0c0f7da7e19b16f6f45bda9719458d182c'
    }
    stages {
        stage('Verify upstream release') {
            steps {
                script {
                    def upstream = jenkins.model.Jenkins.get().getItem('tache-ci').getBuildByNumber(9)
                    if (upstream == null || upstream.isBuilding() || upstream.result.toString() != 'SUCCESS') {
                        error('Verified upstream build tache-ci #9 must remain SUCCESS')
                    }
                    echo 'Promoting release from tache-ci #9: tests, Sonar gate, Nexus and public image already verified.'
                }
                sh '/var/jenkins_home/eks-tools/kubectl version --client'
            }
        }
        stage('Deploy AWS EKS') {
            steps {
                withCredentials([file(credentialsId: 'eks-kubeconfig', variable: 'KUBECONFIG')]) {
                    sh '''set -eu
                        /var/jenkins_home/eks-tools/kubectl --context events-tache-eks -n events-tache set image deployment/events events="$RELEASE_IMAGE"
                        /var/jenkins_home/eks-tools/kubectl --context events-tache-eks -n events-tache patch deployment/events --type=merge -p "$(printf '{"spec":{"template":{"metadata":{"annotations":{"jenkins.io/eks-build":"%s"}}}}}' "$BUILD_TAG")"
                        /var/jenkins_home/eks-tools/kubectl --context events-tache-eks -n events-tache rollout status deployment/events --timeout=600s
                    '''
                }
            }
        }
        stage('Verify AWS application') {
            steps {
                withCredentials([file(credentialsId: 'eks-kubeconfig', variable: 'KUBECONFIG')]) {
                    sh '''set -eu
                        /var/jenkins_home/eks-tools/kubectl --context events-tache-eks -n events-tache port-forward --address 127.0.0.1 service/events 18190:8089 > /tmp/eks-forward-$BUILD_NUMBER.log 2>&1 &
                        forward_pid=$!
                        trap 'kill "$forward_pid" 2>/dev/null || true' EXIT
                        curl --fail --retry 20 --retry-connrefused --retry-delay 2 http://127.0.0.1:18190/events/actuator/health/readiness
                        curl --fail http://127.0.0.1:18190/events/taches
                    '''
                }
            }
        }
    }
}
