{
  "uid": "events-tache",
  "title": "eventsProject — module Tache",
  "description": "Métriques réelles collectées par Prometheus. La readiness et les tests HTTP vérifient séparément la base MySQL.",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "Africa/Tunis",
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Collecte Prometheus (up)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up{job=\"events\"}", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN"}, "1": {"text": "UP"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "id": 2, "type": "stat", "title": "CPU du processus Java",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "process_cpu_usage{job=\"events\"}", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "id": 3, "type": "timeseries", "title": "Mémoire JVM — heap",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(jvm_memory_used_bytes{job=\"events\",area=\"heap\"})", "refId": "A", "legendFormat": "Heap utilisé"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0, "custom": {"fillOpacity": 15, "lineWidth": 2}}, "overrides": []}
    },
    {
      "id": 4, "type": "timeseries", "title": "Requêtes HTTP par seconde",
      "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{job=\"events\"}[2m]))", "refId": "A", "legendFormat": "HTTP / s"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "custom": {"fillOpacity": 15, "lineWidth": 2}}, "overrides": []}
    }
  ]
}
